  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- Npgsql is referenced as a raw DLL (..\lib\Npgsql.dll), so its transitive
       NuGet dependencies (System.Memory, System.Buffers, System.Text.Json,
       System.Text.Encodings.Web, System.Threading.Tasks.Extensions, ...) are NOT
       auto-copied into this project's output. Several are framework facades
       (CopyLocal=false) AND, when building on Linux with `dotnet msbuild`, the
       DataAccessLayer output is never populated with them at all (the BCL
       PackageReference libs are not copy-local'd by dotnet msbuild for old-style
       csproj). So pull each one straight from the NuGet cache so the runtime
       loader finds it next to the exe. Without them NpgsqlConnection.Open()
       throws: "Could not load file or assembly 'System.Threading.Tasks.Extensions,
       Version=4.2.0.1 ...' File not found." Keep the versions below in sync with
       the PackageReference versions in DVLD_DataAccessLayer.csproj. -->
  <Target Name="CopyNpgsqlRuntimeDependencies" AfterTargets="Build">
    <ItemGroup>
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)system.memory\4.5.5\lib\net461\System.Memory.dll" />
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)system.buffers\4.5.1\lib\net461\System.Buffers.dll" />
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)system.text.json\8.0.0\lib\net462\System.Text.Json.dll" />
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)system.text.encodings.web\8.0.0\lib\net462\System.Text.Encodings.Web.dll" />
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)system.runtime.compilerservices.unsafe\6.0.0\lib\netstandard2.0\System.Runtime.CompilerServices.Unsafe.dll" />
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)microsoft.bcl.asyncinterfaces\8.0.0\lib\net462\Microsoft.Bcl.AsyncInterfaces.dll" />
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)system.threading.tasks.extensions\4.5.4\lib\net461\System.Threading.Tasks.Extensions.dll" />
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)system.valuetuple\4.5.0\lib\net461\System.ValueTuple.dll" />
      <NpgsqlRuntimeDeps Include="$(NuGetPackageRoot)system.numerics.vectors\4.6.1\lib\net462\System.Numerics.Vectors.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NpgsqlRuntimeDeps)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
  </Target>

